{
  "name": "match-generator",
  "version": "1.0.0",
  "description": "REST API that generates matches for guess-the-anime",
  "main": "src/index.ts",
  "license": "MIT",
  "keywords": [
    "typescript"
  ],
  "author": {
    "name": "Manuel Mena",
    "email": "manuelmena1993@gmail.com"
  },
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "build": "npm run typecheck && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typegen": "wrangler types worker-configuration.d.ts --include-env false",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "catalog": "node scripts/catalog/cli.mjs",
    "test:catalog": "node --test test/catalog/*.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "wrangler": "4.152.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "0.10.1",
    "hono": "4.13.13"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.18.0 <25"
  }
}
